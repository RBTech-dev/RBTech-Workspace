{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "$id": "tagged-library",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "type": {
      "type": "string",
      "description": "Type of library",
      "enum": ["data-access", "feature", "ui", "util"],
      "default": "feature",
      "x-prompt": {
        "message": "What type of library is it (type)?",
        "type": "list",
        "items": [
          {
            "value": "data-access",
            "label": "Data Access"
          },
          {
            "value": "feature",
            "label": "Feature"
          },
          {
            "value": "ui",
            "label": "Ui"
          },
          {
            "value": "util",
            "label": "Util"
          }
        ]
      }
    },
    "scope": {
      "type": "string",
      "description": "Scope of the library",
      "default": "shared",
      "x-prompt": "What app does this library belong to (scope)?"
    },
    "platform": {
      "type": "string",
      "description": "Platform of the library",
      "enum": ["web-component", "any", "angular"],
      "default": "angular",
      "x-prompt": {
        "message": "What platform can this library run on (platform)?",
        "type": "list",
        "items": [
          {
            "value": "web-component",
            "label": "Web component"
          },
          {
            "value": "any",
            "label": "Any"
          },
          {
            "value": "angular",
            "label": "Angular 2+"
          }
        ]
      }
    },
    "directory": {
      "type": "string",
      "default": "Directory where the generated files are placed.",
      "x-prompt": "What is the directory?",
      "aliases": ["dir", "path"]
    },
    "prefix": {
      "type": "string",
      "default": "pmed",
      "x-prompt": "What is the Prefix?"
    }
  },
  "required": ["name"]
}
