{
  "name": "winbox-example-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/winbox-example-app/src",
  "prefix": "rbtech",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/winbox-example-app",
        "index": "apps/winbox-example-app/src/index.html",
        "main": "apps/winbox-example-app/src/main.ts",
        "polyfills": "apps/winbox-example-app/src/polyfills.ts",
        "tsConfig": "apps/winbox-example-app/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/winbox-example-app/src/favicon.ico",
          "apps/winbox-example-app/src/assets"
        ],
        "styles": ["apps/winbox-example-app/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "150kb",
              "maximumError": "150kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/winbox-example-app/src/environments/environment.ts",
              "with": "apps/winbox-example-app/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "winbox-example-app:build:production"
        },
        "development": {
          "buildTarget": "winbox-example-app:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "winbox-example-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/winbox-example-app/**/*.ts",
          "apps/winbox-example-app/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/winbox-example-app"],
      "options": {
        "jestConfig": "apps/winbox-example-app/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
